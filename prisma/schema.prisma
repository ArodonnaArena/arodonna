datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String
  href        String
  image       String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String   // Markdown
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}